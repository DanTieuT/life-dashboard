# Copy to .env and fill in real values. .env is gitignored — never commit
# real secrets. See AI_ASSISTANT.md for how the AI assistant uses these.

# ── AI assistant (netlify/functions/chat.mjs) ──────────────────────────────
# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-6 if unset. This app uses Anthropic's
# Claude, not OpenAI, despite the OPENAI_API_KEY entry further down existing
# in some local .env files from earlier experiments — it is unused by chat.mjs.
ANTHROPIC_MODEL=

# Firebase Admin credentials, used by every Netlify Function that touches
# Firestore (chat.mjs's financial tools, plaid-sync.js, sync-calendar.js,
# etc.). Base64-encode your service account JSON for this. If unset, the
# functions fall back to a local netlify/functions/service-account.json
# (gitignored) instead — fine for local dev, required to be this env var in
# production since that file isn't deployed.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Plaid (bank linking) ────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
FINNHUB_API_KEY=

# ── Telegram bot (separate JARVIS surface, netlify/functions/telegram.js) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scheduled function auth ────────────────────────────────────────────────
CRON_SECRET=

# ── Optional integrations — safe to leave blank if unused ──────────────────
OPENAI_API_KEY=
OBSIDIAN_API_KEY=
OBSIDIAN_URL=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_CALENDAR_NAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
PROFILE_KEY=
GPT_BRIDGE_KEY=
